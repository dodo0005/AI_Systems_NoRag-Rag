# Copy this file to .env (or .env.local, which wins over .env) and fill it in.

# Any OpenAI-compatible chat completions API.
# Google Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
#   key from https://aistudio.google.com/app/api-keys
# Several keys, comma-separated, are tried in turn when one is rate-limited.
export LLM_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
export LLM_API_KEY="your_api_key_here"
export LLM_MODEL="gemini-3.5-flash-lite"
# Optional: another model for concept graph extraction (default: LLM_MODEL).
# export GRAPH_MODEL=""

# Prices in USD per million tokens, used for the cost estimates in traces.
# Check them on the provider's pricing page and replace these placeholders.
export LLM_PRICE_INPUT_PER_M="0.10"
export LLM_PRICE_OUTPUT_PER_M="0.40"
# Traces older than this are deleted automatically.
export TRACE_RETENTION_DAYS="30"

# Personal data (emails, phones, IBAN, card numbers) is replaced before
# questions and passages are sent to the LLM provider. Set to false to send them.
export REDACT_LLM_INPUT="true"

# Concept graph: refuse a build that needs more new LLM calls than this
# (one call per chunk not already in graph/cache/). Pause between calls, in seconds.
export GRAPH_MAX_NEW_CHUNKS="150"
export GRAPH_CALL_DELAY="4"

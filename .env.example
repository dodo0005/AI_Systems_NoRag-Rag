# Copy this file to .env and replace with your real keys.

# For google gemini, go to https://aistudio.google.com/app/api-keys 
# and create an API key, then copy and paste it here.
export GOOGLE_API_KEY="your_google_api_key_here"
# Optional (V4). Model used for answers.
export GEMINI_MODEL="gemini-3.5-flash-lite"
# Prices in USD per million tokens, used for the cost estimates in traces.
# Check them on the provider's pricing page and replace these placeholders.
export LLM_PRICE_INPUT_PER_M="0.10"
export LLM_PRICE_OUTPUT_PER_M="0.40"
# Traces older than this are deleted automatically.
export TRACE_RETENTION_DAYS="30"